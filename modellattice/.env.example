# Copy to .env and adjust. Never commit the real .env file.

# Postgres is the system of record (Decision C10). For a zero-dependency local
# smoke test you may point this at sqlite+aiosqlite, but JSON columns that use
# JSONB-specific behavior are written to degrade gracefully to generic JSON.
# Port 5455 (not 5432) because this machine already runs other projects'
# Postgres containers/services on 5432 and 5433. Adjust freely for your own
# machine; this only has to match docker-compose.yml's port mapping.
DATABASE_URL=postgresql+psycopg://modellattice:modellattice@localhost:5455/modellattice

# Logical environment name, surfaced in a few admin/debug endpoints.
ENVIRONMENT=development

# Weekly evaluation spend cap in USD (Decision / Open item: Section 17, v0.2).
EVAL_WEEKLY_BUDGET_USD=250

# Comma-separated list of API keys allowed to call write endpoints
# (/v1/feedback, /v1/otlp). Replace before any shared deployment.
API_WRITE_KEYS=dev-local-key

# Required to run REAL evaluations (scripts/run_eval.py) against
# OpenRouter-hosted offerings. Without this, the eval runner refuses to
# make live model calls rather than fabricate results - it never reuses
# another project's API key found in the environment.
OPENROUTER_API_KEY=

# Hard ceiling per single `run_eval.py` invocation, independent of the
# rolling weekly cap below.
EVAL_MAX_RUN_BUDGET_USD=2.00
